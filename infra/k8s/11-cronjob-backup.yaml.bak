apiVersion: batch/v1
kind: CronJob
metadata:
  name: minio-bucket-backup
  namespace: drive-mini
  labels:
    app: minio-backup
spec:
  # Schedule: Daily at 02:00 AM (can be changed to "*/30 * * * *" for frequent testing)
  schedule: "0 2 * * *"
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  concurrencyPolicy: Forbid
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
            app: minio-backup
        spec:
          restartPolicy: OnFailure
          containers:
            - name: mc-backup
              image: quay.io/minio/mc:latest
              command:
                - /bin/sh
                - -c
                - |
                  echo "[Backup CronJob] Starting MinIO Object Storage Backup at $(date)..."
                  
                  # 1. Configure MinIO client alias
                  /usr/bin/mc alias set source http://minio-service:9000 minioadmin minioadmin123
                  
                  # 2. Mirror drive-files bucket to persistent backup volume
                  echo "[Backup CronJob] Mirroring 'drive-files' bucket..."
                  mkdir -p /backup/drive-files-backup
                  /usr/bin/mc mirror --overwrite source/drive-files /backup/drive-files-backup/
                  
                  # 3. Mirror drive-thumbnails bucket
                  echo "[Backup CronJob] Mirroring 'drive-thumbnails' bucket..."
                  mkdir -p /backup/drive-thumbnails-backup
                  /usr/bin/mc mirror --overwrite source/drive-thumbnails /backup/drive-thumbnails-backup/
                  
                  echo "[Backup CronJob] ✅ Object storage backup completed successfully at $(date)!"
                  ls -lh /backup/
              volumeMounts:
                - name: backup-storage
                  mountPath: /backup
          volumes:
            - name: backup-storage
              persistentVolumeClaim:
                claimName: backup-storage-pvc
